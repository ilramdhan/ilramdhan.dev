{
  "$comment": "Bundle-size budgets checked by scripts/check-bundle-size.mjs after `npm run build`. Sizes in KiB. `aggregate: initial` = JS the browser must download before a route renders (entry graph + the static graph of the route chunk matching `route`); PLAN \u00a73.6 caps public routes at 180 KiB gzip. Other budgets = current size + small headroom so CI blocks growth.",
  "budgets": [
    {
      "name": "JS total (gzip)",
      "pattern": "\\.js$",
      "metric": "gzip",
      "aggregate": "sum",
      "maxKiB": 1440
    },
    {
      "name": "Largest JS chunk (gzip)",
      "pattern": "\\.js$",
      "metric": "gzip",
      "aggregate": "max",
      "maxKiB": 1050
    },
    {
      "name": "CSS total (gzip)",
      "pattern": "\\.css$",
      "metric": "gzip",
      "aggregate": "sum",
      "maxKiB": 13.5
    },
    {
      "name": "3D models (raw)",
      "pattern": "\\.(glb|gltf)$",
      "metric": "raw",
      "aggregate": "sum",
      "maxKiB": 240
    },
    {
      "name": "Initial JS /privacy (gzip)",
      "pattern": "\\.js$",
      "route": "^assets/privacy-[\\w-]{8}\\.js$",
      "metric": "gzip",
      "aggregate": "initial",
      "maxKiB": 105
    },
    {
      "name": "Initial JS /blog (gzip)",
      "pattern": "\\.js$",
      "route": "^assets/blog-[\\w-]{8}\\.js$",
      "metric": "gzip",
      "aggregate": "initial",
      "maxKiB": 120
    },
    {
      "name": "Initial JS / (gzip)",
      "pattern": "\\.js$",
      "route": "^assets/home-[\\w-]{8}\\.js$",
      "metric": "gzip",
      "aggregate": "initial",
      "maxKiB": 190
    },
    {
      "name": "3D card chunks (gzip)",
      "pattern": "^assets/(three|HeroCard)-[\\w-]{8}\\.js$",
      "metric": "gzip",
      "aggregate": "sum",
      "maxKiB": 1060
    }
  ]
}
