# Copy to .env.local and fill in. Only VITE_* variables are exposed to the browser.
# Supabase -> Project Settings -> API
# Local dev: `npm run db:start` prints the values (API URL is http://127.0.0.1:54321).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Contact form spam check (Cloudflare Turnstile, optional; off when VITE_TURNSTILE_SITE_KEY is unset).
# With the site key set, the form shows the widget and posts to the Vercel Function api/contact.ts,
# which verifies the token and inserts the message with the service-role key (server-only: never VITE_*).
# Cloudflare dashboard -> Turnstile -> add site. Test keys: site 1x00000000000000000000AA (always passes).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Supabase -> Project Settings -> API -> service_role. Server-only.
SUPABASE_SERVICE_ROLE_KEY=
