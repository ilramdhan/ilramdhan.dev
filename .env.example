# Copy to .env.local and fill in. Only VITE_* variables are exposed to the browser.
# Supabase -> Project Settings -> API
# Local dev: `npm run db:start` prints the values (API URL is http://127.0.0.1:54321).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Contact form + blog comments spam check (Cloudflare Turnstile). With the site key set, both forms post to
# api/contact.ts / api/comment.ts, which verify the token and insert with the service-role key (server-only:
# never VITE_*); comments then wait for approval in /admin/comments. Required once migration 20261127000000 is
# applied (it removes anon inserts); without a site key the forms use the old anon insert until then.
# Cloudflare dashboard -> Turnstile -> add site. Test keys: site 1x00000000000000000000AA (always passes).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional: comma-separated production hostnames the token must come from (no localhost).
TURNSTILE_HOSTNAMES=
# Supabase -> Project Settings -> API -> service_role. Server-only.
SUPABASE_SERVICE_ROLE_KEY=
