# Copy to .env.local and fill in. Only VITE_* variables are exposed to the browser.
# Supabase -> Project Settings -> API
# Local dev: `npm run db:start` prints the values (API URL is http://127.0.0.1:54321).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
