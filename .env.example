# Copy to .env.local and fill in. Only VITE_* variables are exposed to the browser.
# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only (Vercel Functions). Never prefix these with VITE_.
# WAKATIME_API_KEY=
